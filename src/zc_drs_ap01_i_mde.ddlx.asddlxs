@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Invoice Detail',
    typeNamePlural: 'Invoice Details'
}

annotate view ZI_RPT_AP01_I with
{
  -------------------------------------------------------
  -- LINE ITEMS (Sử dụng type: #STANDARD để chặn điều hướng)
  -------------------------------------------------------
  @UI.lineItem: [{ position: 10, type: #STANDARD }]
  @EndUserText.label: 'Accounting Document'
  AccountingDocument;

  @UI.lineItem: [{ position: 20, type: #STANDARD }]
  @EndUserText.label: 'Document Type'
  DocumentType;

  @UI.lineItem: [{ position: 30, type: #STANDARD }]
  @EndUserText.label: 'Posting Date'
  PostingDate;

  @UI.lineItem: [{ position: 40, type: #STANDARD }]
  @EndUserText.label: 'Net Due Date'
  NetDueDate;

  @UI.lineItem: [{ position: 50, type: #STANDARD }]
  @EndUserText.label: 'Open Amount'
  OpenAmount;

  @UI.lineItem: [{ position: 60, type: #STANDARD }]
  @EndUserText.label: 'Days Overdue'
  DaysOverdue;

  -------------------------------------------------------
  -- HIDE KEYS (Nếu không muốn hiện các key dư thừa)
  -------------------------------------------------------
  @UI.hidden: true
  Ledger;
  @UI.hidden: true
  SourceLedger;
}