@EndUserText.label: 'Access Control for File Access'
@MappingRole: true
define role ZI_DRS_FILE {
  grant
    select
      on
        ZI_DRS_FILE
          where
              // Admin sees all
              ( '*' ) = aspect pfcg_auth ( ZDRS_PRIV, ZDRS_SCOPE, ACTVT = '03' )
              // Monitor role (GL_STAFF, HEAD_ACCT) sees all
              or ( 'M' ) = aspect pfcg_auth ( ZDRS_PRIV, ZDRS_SCOPE, ACTVT = '03' )
              // Private role sees own only (via nested association)
              or CreatedBy = aspect user;
}
