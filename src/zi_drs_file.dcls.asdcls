@EndUserText.label: 'Access Control for File Access'
@MappingRole: true
define role ZI_DRS_FILE {
  grant
    select
      on
        ZI_DRS_FILE
          where
            ( _JobConfig._Subscription.ReportId ) =
              aspect pfcg_auth ( ZDRS_REP, ZREP_ID, ACTVT = '03' )
 //           and _JobConfig._Subscription.CreatedBy =
 //             aspect user
            and ( _JobConfig._Subscription.Bukrs ) =
              aspect pfcg_auth ( F_BKPF_BUK, BUKRS, ACTVT = '03' );
}
