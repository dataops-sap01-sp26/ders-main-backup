@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Journal Entry Item',
    typeNamePlural: 'Journal Entry Items'
}

annotate view ZC_DRS_GL01_I with
{
  -------------------------------------------------------
  -- LINE ITEMS: Thêm type: #STANDARD để chặn Click
  -------------------------------------------------------
  
  @UI.lineItem: [{ position: 10, label: 'Co. Code', type: #STANDARD }]
  CompanyCode;

  @UI.lineItem: [{ position: 20, label: 'Year', type: #STANDARD }]
  FiscalYear;

  @UI.lineItem: [{ position: 30, label: 'Doc. Number', type: #STANDARD }]
  AccountingDocument;

  @UI.lineItem: [{ position: 40, label: 'Line Item', type: #STANDARD }]
  LedgerGLLineItem;

  @UI.lineItem: [{ position: 50, label: 'G/L Account', type: #STANDARD }]
  GLAccount;

  @UI.lineItem: [{ position: 55, label: 'Account Type', type: #STANDARD }]
  GLAccountCategory;

  @UI.lineItem: [{ position: 60, label: 'Posting Date', type: #STANDARD }]
  PostingDate;

  @UI.lineItem: [{ position: 70, label: 'Amount', type: #STANDARD }]
  AmountInCompanyCodeCurrency;

  @UI.lineItem: [{ position: 80, label: 'Text', type: #STANDARD }]
  DocumentItemText;

  -------------------------------------------------------
  -- HIDE TECHNICAL FIELDS
  -------------------------------------------------------
  @UI.hidden: true
  CompanyCodeCurrency;

  @UI.hidden: true
  Period;

  @UI.hidden: true
  Ledger;
}