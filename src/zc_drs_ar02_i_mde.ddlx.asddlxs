@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Journal Entry Item',
    typeNamePlural: 'Journal Entry Items'
}

annotate view ZI_RPT_AR02_I with
{
  -------------------------------------------------------
  -- LINE ITEMS: Thêm type: #STANDARD để chặn điều hướng
  -------------------------------------------------------

  @UI.lineItem: [{ position: 10, type: #STANDARD }]
  @EndUserText.label: 'Fiscal Year'
  FiscalYear;

  @UI.lineItem: [{ position: 20, type: #STANDARD }]
  @EndUserText.label: 'Accounting Document'
  AccountingDocument;

  @UI.lineItem: [{ position: 30, type: #STANDARD }]
  @EndUserText.label: 'Item'
  AccountingDocumentItem;

  @UI.lineItem: [{ position: 40, type: #STANDARD }]
  @EndUserText.label: 'Posting Date'
  PostingDate;

  @UI.lineItem: [{ position: 55, type: #STANDARD }]
  @EndUserText.label: 'Debit'
  Debit;

  @UI.lineItem: [{ position: 56, type: #STANDARD }]
  @EndUserText.label: 'Credit'
  Credit;

  @UI.lineItem: [{ position: 58, type: #STANDARD }]
  @EndUserText.label: 'Amount'
  Amount;

  @UI.lineItem: [{ position: 60, type: #STANDARD }]
  @EndUserText.label: 'Currency'
  LocalCurrency;

  -------------------------------------------------------
  -- HIDE KEYS
  -------------------------------------------------------
  @UI.hidden: true
  CompanyCode;

  @UI.hidden: true
  Customer;
}