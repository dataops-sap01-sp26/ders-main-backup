@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Journal Entry Item',
    typeNamePlural: 'Journal Entry Items'
}

annotate view ZI_RPT_AR03_I with
{
  -------------------------------------------------------
  -- LINE ITEMS: Sử dụng type: #STANDARD để chặn điều hướng
  -------------------------------------------------------
  
  @UI.lineItem: [{ position: 5, type: #STANDARD }]
  @EndUserText.label: 'Accounting Document'
  AccountingDocument;

  @UI.lineItem: [{ position: 10, type: #STANDARD }]
  @EndUserText.label: 'Customer Name'
  CustomerName;

  @UI.lineItem: [{ position: 20, type: #STANDARD }]
  @EndUserText.label: 'Posting Date'
  PostingDate;

  @UI.lineItem: [{ position: 30, type: #STANDARD }]
  @EndUserText.label: 'Document Date'
  DocumentDate;

  @UI.lineItem: [{ position: 40, type: #STANDARD }]
  @EndUserText.label: 'Net Due Date'
  NetDueDate;

  @UI.lineItem: [{ position: 50, type: #STANDARD }]
  @EndUserText.label: 'Document Type'
  AccountingDocumentType;

  @UI.lineItem: [{ position: 60, type: #STANDARD }]
  @EndUserText.label: 'Original Amount'
  OriginalAmount;

  -------------------------------------------------------
  -- HIDE/LABEL OTHERS
  -------------------------------------------------------
  @UI.hidden: true
  CompanyCode;

  @UI.hidden: true
  Customer;

  @EndUserText.label: 'Currency'
  LocalCurrency;
}