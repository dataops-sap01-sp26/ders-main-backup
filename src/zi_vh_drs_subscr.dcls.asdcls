@EndUserText.label: 'Access Control for Subscription Value Help'
@MappingRole: true
define role ZI_VH_DRS_SUBSCR {
  grant
    select
      on
        ZI_VH_DRS_SUBSCR
          where
            ( ReportId ) =
              aspect pfcg_auth ( ZDRS_REP, ZREP_ID, ACTVT = '03' )
            and ( CreatedBy = aspect user )
            and ( Bukrs ) =
              aspect pfcg_auth ( F_BKPF_BUK, BUKRS, ACTVT = '03' );
}