// Behavior definition for Report Catalog.
// Read-only consumption of catalog master data; persistence is maintained
// via the seeding program (no transactional UI exposes write operations).
managed implementation in class ZBP_DRS_CATALOG unique;
strict ( 2 );

define behavior for ZIR_DRS_CATALOG alias Catalog
persistent table zdrs_catalog
lock master
authorization master ( global )
etag master LocalLastChangedAt

{
  mapping for zdrs_catalog
  {
    ReportId = report_id;
    ModuleId = module_id;
    ReportName = report_name;
    Description = description;
    LongText = long_text;
    CdsViewName = cds_view_name;
    ReportClass = report_class;
    IsActive = is_active;
    SortOrder = sort_order;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}