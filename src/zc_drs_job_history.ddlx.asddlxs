  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 40 } ]
  }
  @EndUserText.label: 'Generated By'
  FileCreatedBy;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 50 } ]
  }
  @EndUserText.label: 'Generated At'
  FileCreatedAt;

  @UI: {
    lineItem: [ { position: 10, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'GeneralInfo', position: 10 } ],
    selectionField: [ { position: 50 } ]
  }
  @EndUserText.label: 'Report ID'
  ReportId;

  @UI: {
    lineItem: [ { position: 20, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'GeneralInfo', position: 20 } ]
  }
