  @UI: {
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 70 } ]
  }
  @EndUserText.label: 'Retry Count'
  RetryCount;

  @UI: {
    fieldGroup: [ { qualifier: 'AdminData', position: 10 } ],
