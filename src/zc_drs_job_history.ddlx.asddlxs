@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Job History',
    typeNamePlural: 'Job Histories',
    title: { type: #STANDARD, value: 'JobName' },
    description: { value: 'Message' }
  }
}
annotate entity ZC_DRS_JOB_HISTORY with
{
  @UI.facet: [
    {
      id: 'GeneralInfo',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'GeneralInfo',
      label: 'General Information',
      position: 10
    },
    {
      id: 'ExecutionDetails',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ExecutionDetails',
      label: 'Execution Details',
      position: 20
