  }
  @EndUserText.label: 'Job Status'
  JobStatus;

  @UI.hidden: true
  JobStatusCriticality;

  @UI: {
    lineItem: [ { position: 40, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 20 } ]
  }
  @EndUserText.label: 'Start Timestamp'
  StartTimestamp;

  @UI: {
    lineItem: [ { position: 50, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 30 } ]
  }
