@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Job History',
    typeNamePlural: 'Job Histories',
    title: { type: #STANDARD, value: 'JobName' },
    description: { value: 'Message' }
  }
}
annotate entity zc_drs_job_history with
{
  @UI.facet: [
    {
      id: 'GeneralInfo',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'GeneralInfo',
      label: 'General Information',
      position: 10
    },
    {
      id: 'ExecutionDetails',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ExecutionDetails',
      label: 'Execution Details',
      position: 20
    },
    {
      id: 'ReportFileDetails',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ReportFileDetails',
      label: 'Report File',
      position: 25
    },
    {
      id: 'AdminData',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'AdminData',
      label: 'Administrative Data',
      position: 30
    }
  ]

  @UI.hidden: true
  jobhistuuid;

  @UI.hidden: true
  jobuuid;

  @UI.hidden: true
  fileuuid;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 10 } ],
    selectionField: [ { position: 50 } ]
  }
  @EndUserText.label: 'File Name'
  filename;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 20 } ]
  }
  @EndUserText.label: 'File Download'
  filecontent;

  @UI.hidden: true
  filesize;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 30 } ]
  }
  @EndUserText.label: 'File Size'
  filesizedisplay;

  @UI.hidden: true
  mimetype;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 40 } ]
  }
  @EndUserText.label: 'Generated By'
  filecreatedby;

  @UI: {
    fieldGroup: [ { qualifier: 'ReportFileDetails', position: 50 } ]
  }
  @EndUserText.label: 'Generated At'
  filecreatedat;

  @UI: {
    lineItem: [ { position: 10, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'GeneralInfo', position: 10 } ],
    selectionField: [ { position: 30 } ]
  }
  @EndUserText.label: 'Report ID'
  reportid;

  @UI: {
    lineItem: [ { position: 20, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'GeneralInfo', position: 20 } ]
  }
  @EndUserText.label: 'Job Name'
  jobname;

  @UI: {
    fieldGroup: [ { qualifier: 'GeneralInfo', position: 30 } ]
  }
  @EndUserText.label: 'Job Count'
  jobcount;

  @UI.hidden: true
  jobcatalogentry;

  @UI.hidden: true
  jobtemplatename;

  @UI: {
    lineItem: [ { position: 30, importance: #HIGH, criticality: 'JobStatusCriticality' } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 10, criticality: 'JobStatusCriticality' } ]
  }
  @EndUserText.label: 'Job Status'
  jobstatus;

  @UI.hidden: true
  jobstatuscriticality;

  @UI: {
    lineItem: [ { position: 40, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 20 } ]
  }
  @EndUserText.label: 'Start Timestamp'
  starttimestamp;

  @UI: {
    lineItem: [ { position: 50, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 30 } ]
  }
  @EndUserText.label: 'End Timestamp'
  endtimestamp;

  @UI: {
    lineItem: [ { position: 60, importance: #MEDIUM } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 40 } ]
  }
  @EndUserText.label: 'Duration (ms)'
  durationms;

  @UI: {
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 50 } ],
    selectionField: [ { position: 40 } ]
  }
  @EndUserText.label: 'Output Format'
  outputformat;

  @UI: {
    lineItem: [ { position: 70, importance: #MEDIUM } ],
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 60 } ]
  }
  @EndUserText.label: 'Message'
  message;

  @UI: {
    fieldGroup: [ { qualifier: 'ExecutionDetails', position: 70 } ]
  }
  @EndUserText.label: 'Retry Count'
  retrycount;

  @UI: {
    fieldGroup: [ { qualifier: 'AdminData', position: 10 } ],
    selectionField: [ { position: 20 } ]
  }
  @EndUserText.label: 'Created By'
  createdby;

  @UI: {
    lineItem: [ { position: 80, importance: #MEDIUM } ],
    fieldGroup: [ { qualifier: 'AdminData', position: 20 } ]
  }
  @EndUserText.label: 'Created At'
  createdat;

  @UI: {
    fieldGroup: [ { qualifier: 'AdminData', position: 30 } ]
  }
  @EndUserText.label: 'Last Changed By'
  lastchangedby;

  @UI: {
    fieldGroup: [ { qualifier: 'AdminData', position: 40 } ]
  }
  @EndUserText.label: 'Last Changed At'
  lastchangedat;

  @UI: {
    fieldGroup: [ { qualifier: 'AdminData', position: 50 } ]
  }
  @EndUserText.label: 'Local Last Changed At'
  locallastchangedat;

  @UI: {
  selectionField: [ { position: 10 } ]
  }
  @EndUserText.label: 'Job Date'
  jobdate;

}