managed implementation in class zbp_r_subscr unique;
strict ( 2 );
with draft;

// ═══════════════════════════════════════════════════════════════════════════════
// ROOT ENTITY: Subscription (US-E3-001 to US-E3-011)
// COMPOSITION: ParamGL01 is child entity (lifecycle managed by parent)
// ═══════════════════════════════════════════════════════════════════════════════
define behavior for ZIR_DRS_SUBSCR alias Subscription
persistent table zdrs_subscr
draft table zdrs_d_subscr
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global, instance )
early numbering

{
  // Standard CRUD
  create;
  update;
  delete;

  // Key fields - generated by early numbering, so readonly
  field ( readonly )
  SubscrUuid,
  SubscrId;

  field ( mandatory )
  SubscrName;

  field ( features : instance, mandatory ) ReportId;

  // System fields (managed automatically)
  field ( readonly )
  Status,
  StatusText,
  StatusCriticality,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  // ─────────────────────────────────────────────────────────────────────────────
  // COMPOSITION: Report-specific parameters (Child entities)
  // Cascade delete handled automatically by RAP
  // ─────────────────────────────────────────────────────────────────────────────
  association _ParamGL01 { create; with draft; }
  association _ParamAR01 { create; with draft; }
  association _ParamAR02 { create; with draft; }
  association _ParamAR03 { create; with draft; }
  association _ParamAP01 { create; with draft; }
  association _ParamAP02 { create; with draft; }
  association _ParamAP03 { create; with draft; }
  association _Customers { create; with draft; }
  association _Vendors { create; with draft; }

  // ─────────────────────────────────────────────────────────────────────────────
  // DRAFT ACTIONS
  // ─────────────────────────────────────────────────────────────────────────────
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateDescription;
    validation validateReport;
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // CUSTOM ACTIONS (US-E3-008, US-E3-009, US-E3-010)
  // ─────────────────────────────────────────────────────────────────────────────
  // Copy Subscription with all parameters
  action copySubscription result [1] $self;

  // Pause - Update status (US-E3-008)
  action pauseSubscription result [1] $self;

  // Resume - Update status (US-E3-009)
  action resumeSubscription result [1] $self;

  // Create Report Parameters - reads ReportId and creates in correct table
  // GL01 → zdrs_param_gl01, AR01 → zdrs_param_ar01, etc.
  action createReportParams result [1] $self;

  //   Validations
  validation validateDescription on save { create; update; field SubscrName; }
  validation validateReport on save { create; update; field ReportId; }


  // ─────────────────────────────────────────────────────────────────────────────
  // DETERMINATIONS
  // ─────────────────────────────────────────────────────────────────────────────
  determination setDefaultValue on modify { create; }

  // NOTE: cascadeDeleteParams removed - composition handles cascade delete automatically
  determination CleanupOnReportChange on modify { field ReportId; create; }

  // ─────────────────────────────────────────────────────────────────────────────
  // MAPPINGS
  // ─────────────────────────────────────────────────────────────────────────────
  mapping for zdrs_subscr
  {
    SubscrUuid = subscr_uuid;
    SubscrId = subscr_id;
    SubscrName = subscr_name;
    ReportId = report_id;
    Bukrs = bukrs;
    OutputFormat = output_format;
    EmailTo = email_to;
    EmailCc = email_cc;
    Status = status;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// CHILD ENTITY: GL01 Parameters (Composition child of Subscription)
// Lifecycle managed by parent - cascade delete when Subscription deleted
// ═══════════════════════════════════════════════════════════════════════════════
define behavior for ZI_DRS_PARAM_GL01 alias ParamGL01
persistent table zdrs_param_gl01
draft table zdrs_d_pgl01
lock dependent by _Subscription
authorization dependent by _Subscription
{
  // Standard operations
  update;
  delete;

  // Key fields - set from parent context, readonly
  field ( readonly )
  SubscrUuid,
  SubscrId;

  //  field ( mandatory )
  //  CompanyCode,
  //  FiscalYear,
  //  FiscalPeriodFr,
  //  FiscalPeriodTo,
  //  GlAccountFr,
  //  GlAccountTo;

  // Parent association (required for composition)
  association _Subscription { with draft; }

  // ─────────────────────────────────────────────────────────────────────────────
  // MAPPINGS
  // ─────────────────────────────────────────────────────────────────────────────
  mapping for zdrs_param_gl01
  {
    SubscrUuid = subscr_uuid;
    SubscrId = subscr_id;
    CompanyCode = company_code;
    FiscalYearFr = fiscal_year_from;
    FiscalYearTo = fiscal_year_to;
    FiscalPeriodFr = fiscal_period_from;
    FiscalPeriodTo = fiscal_period_to;
    Currency = currency;
    GlAccountFr = gl_account_from;
    GlAccountTo = gl_account_to;
    MaxRows = max_rows;
  }
}
