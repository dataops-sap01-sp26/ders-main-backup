  JobUuid;

  @UI: {
  selectionField: [ { position: 10 } ]
  }
  @EndUserText.label: 'Job Date'
  JobDate;

  @UI: {
    lineItem: [ { position: 5, importance: #HIGH } ],
    selectionField: [ { position: 40 } ]
  }
  @EndUserText.label: 'Job ID'
  JobId;

  @UI: {
    lineItem: [
      { position: 10, importance: #HIGH },
      { type: #FOR_ACTION, dataAction: 'scheduleJob', label: 'Schedule Job' },
      { type: #FOR_ACTION, dataAction: 'cancelJob', label: 'Cancel Job' },
      { type: #FOR_ACTION, dataAction: 'refreshStatus', label: 'Refresh Status' }
    ],
    identification: [
      { type: #FOR_ACTION, dataAction: 'scheduleJob',   label: 'Schedule Job',   position: 10 },
      { type: #FOR_ACTION, dataAction: 'cancelJob',     label: 'Cancel Job',     position: 20 },
      { type: #FOR_ACTION, dataAction: 'refreshStatus', label: 'Refresh Status', position: 30 }
    ]
  }
  JobText;

  @UI: {
    lineItem: [ { position: 20, importance: #HIGH } ],
    fieldGroup: [ { qualifier: 'GeneralSettings', position: 10 } ]
  }
  @EndUserText.label: 'Run Type'
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_VH_DRS_RUN_TYPE', element: 'Value' },
    useForValidation: true
  }]
  RunType;

  @UI: {
