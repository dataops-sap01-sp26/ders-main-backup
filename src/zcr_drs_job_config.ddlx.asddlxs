@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Job Config',
    typeNamePlural: 'Job Config',
    title: { type: #STANDARD, value: 'JobId' },
    description: { value: 'JobText' }
  }
}
annotate entity ZCR_DRS_JOB_CONFIG with
{
  @UI.facet: [
   {
      id: 'GeneralSettings',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'GeneralSettings',
      label: 'General Settings',
      position: 10
    },
    {
