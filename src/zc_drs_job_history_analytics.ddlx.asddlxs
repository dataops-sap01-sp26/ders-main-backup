@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Job Execution',
    typeNamePlural: 'Job Executions',
    title: { type: #STANDARD, value: 'JobName' },
    description: { value: 'Message' }
  },
  chart: [{
    qualifier: 'ChartDefault',
    title: 'Job Executions by Date & Status',
    chartType: #COLUMN_STACKED,
    dimensions: ['JobDate', 'JobStatus'],
    measures: ['JobCount'],
    dimensionAttributes: [
      { dimension: 'JobDate',   role: #CATEGORY },
      { dimension: 'JobStatus', role: #SERIES }
    ],
    measureAttributes: [{
      measure: 'JobCount',
      role: #AXIS_1
    }]
  }],
  presentationVariant: [{
    qualifier: 'Default',
    visualizations: [{
      type: #AS_CHART,
      qualifier: 'ChartDefault'
    }]
  }]
}
annotate entity ZI_DRS_JOB_HISTORY_ANALYTICS with
{
  @UI.hidden: true
  JobHistUuid;

  @UI: {
    lineItem: [{ position: 10, importance: #HIGH }],
    selectionField: [{ position: 10 }]
  }
  @EndUserText.label: 'Job Date'
  JobDate;

  @UI: {
    lineItem: [{ position: 20, importance: #HIGH, criticality: 'JobStatusCriticality' }],
    selectionField: [{ position: 20 }]
  }
  @EndUserText.label: 'Job Status'
  JobStatus;

  @UI.hidden: true
  JobStatusCriticality;

  @UI: {
    lineItem: [{ position: 30, importance: #HIGH }]
  }
  @EndUserText.label: 'Job Name'
  JobName;

  @UI: {
    lineItem: [{ position: 40, importance: #MEDIUM }]
  }
  @EndUserText.label: 'Report ID'
  ReportId;

  @UI: {
    lineItem: [{ position: 50, importance: #MEDIUM }]
  }
  @EndUserText.label: 'Message'
  Message;

  @UI: {
    lineItem: [{ position: 60, importance: #MEDIUM }]
  }
  @EndUserText.label: 'Start Timestamp'
  StartTimestamp;

  @UI: {
    lineItem: [{ position: 70, importance: #MEDIUM }]
  }
  @EndUserText.label: 'End Timestamp'
  EndTimestamp;

  @UI: {
    lineItem: [{ position: 80, importance: #LOW }]
  }
  @EndUserText.label: 'Duration (ms)'
  DurationMs;

  @UI: {
    lineItem: [{ position: 90, importance: #LOW }]
  }
  @EndUserText.label: 'Created By'
  CreatedBy;

  @UI.hidden: true
  JobCount;
}