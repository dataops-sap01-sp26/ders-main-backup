@EndUserText.label: 'Service Definition for Report Catalog'
define service ZSD_RPT_REPORT_CATALOG {
  expose ZI_RPT_AP01 as VendorOpenItems;
  expose ZI_RPT_AP01_I as VendorOpenItemsDetail;
  expose ZI_RPT_AP02 as VendorBalances;
  expose ZI_RPT_AP02_I as VendorBalancesDetail;
  expose ZI_RPT_AP03 as APAgingReport;
  expose ZI_RPT_AP03_I as APAgingReportDetail;
  expose ZI_RPT_AR01 as CustomerOpenItems;
  expose ZI_RPT_AR01_I as CustomerOpenItemsDetail;
  expose ZI_RPT_AR02 as CustomerBalances;
  expose ZI_RPT_AR02_I as CustomerBalancesDetail;
  expose ZI_RPT_AR03 as ARAgingReport;
  expose ZI_RPT_AR03_I as ARAgingReportDetail;
  expose ZCR_RPT_GL01 as GLAccountBalances;
  expose ZC_RPT_GL01_I as GLAccountBalancesDetail;
}