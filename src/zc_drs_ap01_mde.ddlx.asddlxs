@Metadata.layer: #CORE

---------------------------------------------------------
-- ENTITY LEVEL ANNOTATIONS (Nằm ngoài annotate view)
---------------------------------------------------------
@UI.headerInfo: {
   typeName: 'Vendor Open Items',
   typeNamePlural: 'Vendor Open Items',
   title: { value: 'Supplier' },
   description: { value: 'SupplierName' }
}

annotate view ZI_RPT_AP01 with
{
  -------------------------------------------------------
  -- FACET DEFINITIONS (Cấu hình các khu vực trên Object Page)
  -------------------------------------------------------
  @UI.facet: [
    {
      id: 'Summary',
      type: #IDENTIFICATION_REFERENCE,
      label: 'Summary',
      position: 10
    },
    {
      id: 'InvoiceDetails',
      type: #LINEITEM_REFERENCE,
      label: 'Invoice Details',
      position: 20,
      targetElement: '_Items'
    }
  ]

  -------------------------------------------------------
  -- ELEMENT ANNOTATIONS (Cấu hình từng trường)
  -------------------------------------------------------
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Ledger;

  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  SourceLedger;

  @UI.selectionField: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.lineItem: [{ position: 10 }]
  @EndUserText.label: 'Company Code'
  @Consumption.filter.mandatory: true
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCode', element: 'CompanyCode' } }]
  @Consumption.filter: { selectionType: #SINGLE, multipleSelections: false }
  CompanyCode;

  @UI.selectionField: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @UI.lineItem: [{ position: 20 }]
  @EndUserText.label: 'Vendor'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_Supplier', element: 'Supplier' } }]
  Supplier;

  @UI.identification: [{ position: 20 }]
  @UI.lineItem: [{ position: 30 }]
  @EndUserText.label: 'Vendor Name'
  SupplierName;

  @UI.identification: [{ position: 40 }]
  @UI.lineItem: [{ position: 40 }]
  @EndUserText.label: 'Total Open Amount'
  TotalOpenAmount;

  @UI.identification: [{ position: 50 }]
  @UI.lineItem: [{ position: 50 }]
  @EndUserText.label: 'Currency'
  LocalCurrency;

  @UI.identification: [{ position: 60 }]
  @UI.lineItem: [{ position: 60 }]
  @EndUserText.label: 'Max Days Overdue'
  MaxDaysOverdue;

  @UI.identification: [{ position: 70 }]
  @UI.lineItem: [{ position: 70 }]
  @EndUserText.label: 'Net Due Date'
  NetDueDate;
}