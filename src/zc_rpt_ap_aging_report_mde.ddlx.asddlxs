@Metadata.layer: #CORE

@UI.headerInfo: {
   typeName: 'Vendor Balance',
   typeNamePlural: 'Vendor Balances',
   title: { value: 'CompanyCode' },
   description: { value: 'Supplier' }
}

@UI.presentationVariant: [{
    sortOrder: [{ by: 'Bucket_Over_90', direction: #DESC }],
    visualizations: [{ type: #AS_LINEITEM }] -- Bỏ #AS_CHART nếu bạn chưa định nghĩa @UI.chart
}]

annotate view ZC_RPT_AP_AGING_REPORT with
{
  -------------------------------------------------------
  -- FACETS
  -------------------------------------------------------
  @UI.facet: [
    { id: 'General', type: #IDENTIFICATION_REFERENCE, label: 'General Information', position: 10 },
    { id: 'Items', type: #LINEITEM_REFERENCE, label: 'Journal Entry Items', position: 20, targetElement: '_Items' }
  ]

  -------------------------------------------------------
  -- FIELD ANNOTATIONS
  -------------------------------------------------------
  @UI.lineItem: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @EndUserText.label: 'Company Code'
  CompanyCode;

  @UI.lineItem: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @EndUserText.label: 'Supplier'
  Supplier;

  @UI.lineItem: [{ position: 25 }]
  @EndUserText.label: 'Supplier Name'
  SupplierName;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @EndUserText.label: 'Currency'
  LocalCurrency;
    
  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @EndUserText.label: 'Total Payables'
  TotalAmount;

  @UI.lineItem: [{ position: 50 }]
  @EndUserText.label: 'Not Due'
  Bucket_NotDue;

  @UI.lineItem: [{ position: 60 }]
  @EndUserText.label: '0 - 30 Days'
  Bucket_0_30;

  @UI.lineItem: [{ position: 70 }]
  @EndUserText.label: '31 - 60 Days'
  Bucket_31_60;

  @UI.lineItem: [{ position: 80 }]
  @EndUserText.label: '61 - 90 Days'
  Bucket_61_90;

  @UI.lineItem: [{ position: 90 }]
  @EndUserText.label: 'Over 90 Days'
  Bucket_Over_90;
}