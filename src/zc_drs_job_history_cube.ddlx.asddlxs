@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Job Execution Information',
    typeNamePlural: 'Job Executions',
    title: { type: #STANDARD, value: 'JobText' },
    description: { value: 'Message' }
  },
  chart: [{
    qualifier: 'ChartDefault',
    title: 'Job Executions by Date & Status',
    chartType: #COLUMN_STACKED,
    dimensions: ['ExecutionDate', 'JobStatus'],
    measures: ['JobCountTotal'],
    dimensionAttributes: [
      { dimension: 'ExecutionDate',   role: #CATEGORY },
      { dimension: 'JobStatus', role: #SERIES }
    ],
    measureAttributes: [{
      measure: 'JobCountTotal',
      role: #AXIS_1
    }]
  }],
  presentationVariant: [{
    qualifier: 'Default',
    visualizations: [{
      type: #AS_CHART,
      qualifier: 'ChartDefault'
    }]
  }, 
  {
    sortOrder: [{
      by: 'EndTimestamp',
      direction: #DESC
    }],
    visualizations: [{
      type: #AS_LINEITEM
    }]
  }]
}
annotate entity ZI_DRS_JOB_HISTORY_CUBE with
{
  @UI.facet: [
    {
      id: 'GeneralInfo',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'GeneralInfo',
      label: 'General Information',
      position: 10
    },
    {
      id: 'ExecutionDetails',
      purpose: #STANDARD,
