projection;
strict ( 2 );
use draft;

define behavior for ZC_DRS_JOB_CONFIG alias DrsJobConfig
{
  use create;
  use update;
  use delete;

  use action scheduleJob;
  use action cancelJob;
  use action refreshStatus;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _File { create; with draft; }
}

define behavior for ZC_DRS_FILE alias DrsFile
{

  use association _JobConfig { with draft; }
}